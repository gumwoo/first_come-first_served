# 복사해서 terraform.tfvars 로 쓴다 (tfvars는 .gitignore 대상).
#
#   cp terraform.tfvars.example terraform.tfvars

# EKS API에 접근할 관리자 공인 IP. 기본값이 없으므로 반드시 지정해야 한다.
# 현재 IP 확인:  curl -s https://checkip.amazonaws.com
cluster_public_access_cidrs = ["YOUR_PUBLIC_IP/32"]

# apply 전에 지원 버전을 확인하고 맞춘다.
#   aws eks describe-cluster-versions --region ap-northeast-2
# kubernetes_version = "1.34"

# 부하테스트(S10) 때만 비버스터블로 올린다 — t3는 CPU 크레딧이 측정에 개입한다.
# node_instance_type = "m6i.large"
