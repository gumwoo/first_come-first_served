{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "enums.yaml",
  "type": "object",
  "minProperties": 1,
  "additionalProperties": {
    "type": "object",
    "required": ["values"],
    "additionalProperties": false,
    "properties": {
      "values": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string" },
        "uniqueItems": true
      },
      "transitions": {
        "type": "object",
        "additionalProperties": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "backend_only": {
        "type": "boolean",
        "description": "API로 노출되지 않는 서버 내부 상태 → FE 타입 미러 면제(BE enum 일치는 계속 검사)"
      }
    }
  }
}
